# ==============================================================================
# RAG Chunk Lifecycle Service (rag-chunk-lifecycle-service)
# Environment Configuration Template (.env.example)
# ==============================================================================
# DEVELOPER NOTICE:
# - `.env` is intended strictly for local development and testing.
# - `.env.prod` is the SINGLE SOURCE OF TRUTH for deployment configurations.
# - Only changes to `.env.prod` affect deployments/ (Helm values and Kubernetes).
# - Run `python scripts/sync_env_to_deployments.py --sync` after updating `.env.prod`.
# - Automated git pre-commit hooks enforce zero drift between .env.prod and values.yaml.
# ==============================================================================

# ENVIRONMENT: Target deployment runtime (e.g. production, staging, development).
ENVIRONMENT=production

# HTTP_PORT: Port for administrative REST endpoints, health probes, and Prometheus telemetry.
HTTP_PORT=8080

# GRPC_PORT: Port for high-throughput gRPC streaming ingress & Apache Arrow Flight.
GRPC_PORT=50051

# Structured Observability & Logging
LOG_LEVEL=info

# DATABASE_URL: PostgreSQL connection URI with credentials, target host, port, and database.
# Standard K8s/PgBouncer: postgres://chunk_user:REPLACE_WITH_PRODUCTION_PASSWORD@pgbouncer.database.svc.cluster.local:6432/chunk_lifecycle?sslmode=require
# Neon (Serverless): postgres://neondb_owner:YOUR_PASSWORD@ep-xyz-pooler.us-east-2.aws.neon.tech/chunk_lifecycle?sslmode=require
DATABASE_URL=postgres://chunk_user:REPLACE_WITH_PRODUCTION_PASSWORD@pgbouncer.database.svc.cluster.local:6432/chunk_lifecycle?sslmode=require

# REDIS_ADDR / REDIS_URL: Redis connection configuration.
# Option 1 (Full Connection URL, e.g. Upstash TCP): REDIS_URL=rediss://default:YOUR_PASSWORD@endpoint.upstash.io:6379
# Option 2 (Standard cluster/host:port): REDIS_ADDR=redis-cluster.cache.svc.cluster.local:6379
# Option 3 (Host with separate password): REDIS_ADDR=endpoint.upstash.io:6379, REDIS_PASSWORD=YOUR_PASSWORD
REDIS_ADDR=redis-cluster.cache.svc.cluster.local:6379
# REDIS_URL=
# REDIS_PASSWORD=


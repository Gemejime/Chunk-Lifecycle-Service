# ==============================================================================
# rag-chunk-lifecycle-service Environment Configuration Template
# ==============================================================================

# Application Network Ports
HTTP_PORT=8080
GRPC_PORT=50051

# Structured Logging
# Options: debug, info, warn, error
LOG_LEVEL=info

# Primary Relational Persistence (PostgreSQL 16+)
# Connection string with PgBouncer / direct PostgreSQL pool
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chunk_lifecycle?sslmode=disable

# Low-Latency Context Read Plane (Redis 7.2 Cluster / Standalone)
REDIS_ADDR=localhost:6379
